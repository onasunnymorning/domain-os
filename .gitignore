# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# ENV
.env
.env.tilt
.env.backup

# Terraform
.terraform/
.terraform.lock.hcl
terraform.tfstate*
values.yaml
values.*.yaml

# Chachefile
gke_gcloud_auth_plugin_cache


# MAC
.DS_Store

# Dependency directories (remove the comment below to include it)
# vendor/

# Node deps. frontend/.gitignore only anchors /node_modules to that directory,
# so a root node_modules (e.g. from an npm command run outside frontend/) was
# never ignored. Its vitest cache used to get committed.
node_modules/

# Go workspace file
go.work

# IDE
.idea

# Local scrap files
scraps/
local/
backups/

# Omit the local generated docs (we do need them locally so that code validation will not complain)
docs/*.json
docs/*.yaml

# don't publish these
temporal-certs/
# Build output at the repo root (S7, 2026-09-23 architecture review).
# `go build ./cmd/<x>` run from the root writes a binary named after the last
# path element of the package, and ~250 MB of those got committed. Build into
# bin/ instead (Makefile.epp and Makefile.epp-server already do). One entry per
# `package main` under cmd/; add a line here when you add one there. Anchored
# with a leading slash so the cmd/ source directories of the same name are not
# ignored. escrowImport is a retired command, kept because the binary was
# committed once.
/bin/
/askg
/dbconstraints
/dbimporter
/epp
/epp-client
/escrow
/escrowImport
/gencontract
/genenvexample
/import
/importer
/jisc
/lifecycle
/mcp
/mosapi
/play
/ry-admin
/sync
/unified
/whois
/whoisLoad

# Local analysis output and scratch copies at the root. Escrow deposit dumps
# and analysis databases can carry registrar or registrant contact data; this
# repo is public.
/*.bak
/*.db
/*.sqlite
/analysis_debug.json
/test_input.json
/coverage.html
/api-coverage.html
/agent-coverage.html
