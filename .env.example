# ============================================================================
# domain-os — local development environment
# ============================================================================
#
# GENERATED FILE — do not edit by hand.
#   Source:      internal/config/env_registry.go
#   Regenerate:  make generate-env-example
#   Guarded by:  TestEnvExampleDrift
#
# Quick start:
#
#   cp .env.example .env
#
# That is the whole configuration step. Every value below is a working local
# default; you do not need to change any of them to run 'make dev'.
#
# LOCAL DEVELOPMENT REQUIRES NO CLOUD CREDENTIALS. There is no AWS key, no
# Doppler login, no Grafana Cloud token, and no Auth0 tenant in the local boot
# or test path. Every [SECRET] below is either a local container's documented
# default or is left deliberately empty because local does not need it.
#
# Annotations:
#   [REQUIRED]  the service will not start without it
#   [OPTIONAL]  has a working default
#   [SECRET]    credential material in production — never commit a real value
#   [CLOUD]     only needed when pointing at a hosted service; ignore locally
# ============================================================================

# Docker image tag for the app services. Compose falls back to "latest" when
# unset; 'make dev' builds these locally so the tag is only a local cache label.
BRANCH="latest"

# PostgreSQL connection URL. Embeds the password, so it is credential
# material. Alternative to the DB_* set — configure one of the two; on AWS
# prefer DB_* so the managed password never passes through a URL.
# Used by: api, worker
# [OPTIONAL] [SECRET] [CLOUD] — not needed for local development
DATABASE_URL=""

# PostgreSQL user. The DB_* set is the production credential path on AWS
# ECS; used whenever DATABASE_URL is unset
# Used by: api, worker, mcp, whois, cli
# [OPTIONAL]
DB_USER="postgres"

# PostgreSQL password. The DB_* set is the production credential path on AWS
# ECS (inject from the secret store); used whenever DATABASE_URL is unset
# Used by: api, worker, mcp, whois, cli
# [OPTIONAL] [SECRET]
DB_PASS="postgres"

# PostgreSQL host; used whenever DATABASE_URL is unset
# Used by: api, worker, mcp, whois, cli
# [OPTIONAL]
DB_HOST="localhost"

# PostgreSQL port; used whenever DATABASE_URL is unset
# Used by: api, worker, mcp, whois, cli
# [OPTIONAL]
DB_PORT="5432"

# PostgreSQL database name; used whenever DATABASE_URL is unset
# Used by: api, worker, mcp, whois, cli
# [OPTIONAL]
DB_NAME="domain_os"

# PostgreSQL SSL mode
# Used by: api, worker, mcp, whois, cli
# [OPTIONAL]
DB_SSLMODE="disable"

# Run GORM AutoMigrate on startup
# Used by: api
# [OPTIONAL]
AUTO_MIGRATE="true"

# Enable Auth0 JWT validation
# Used by: api, worker
# [OPTIONAL]
AUTH0_ENABLED="false"

# Auth0 tenant domain (e.g. dev-xxx.us.auth0.com)
# Used by: api, worker
# [OPTIONAL]
AUTH0_DOMAIN=""

# Auth0 API identifier (e.g. https://api.alpaca-test)
# Used by: api, worker
# [OPTIONAL]
AUTH0_AUDIENCE=""

# Auth0 M2M client ID for worker (preferred over AUTH0_CLIENT_ID)
# Used by: worker
# [OPTIONAL]
AUTH0_WORKER_CLIENT_ID=""

# Auth0 M2M client secret for worker
# Used by: worker
# [REQUIRED] [SECRET] [CLOUD] — not needed for local development
AUTH0_WORKER_CLIENT_SECRET=""

# Auth0 client ID fallback (if WORKER variant not set)
# Used by: worker
# [OPTIONAL]
AUTH0_CLIENT_ID=""

# Auth0 client secret fallback (if WORKER variant not set)
# Used by: worker
# [OPTIONAL] [SECRET] [CLOUD] — not needed for local development
AUTH0_CLIENT_SECRET=""

# Legacy bearer token (fallback when Auth0 disabled)
# Used by: api, worker, cli
# [OPTIONAL] [SECRET]
ADMIN_TOKEN="devtoken"

# Full API URL (e.g. https://api.example.com). Preferred over
# API_HOST+API_PORT.
# Used by: worker
# [OPTIONAL]
API_URL=""

# API bind host / target host for worker calls
# Used by: api, worker
# [OPTIONAL]
API_HOST="0.0.0.0"

# API bind port / target port for worker calls
# Used by: api, worker
# [OPTIONAL]
API_PORT="8080"

# API name for Swagger docs
# Used by: api
# [OPTIONAL]
API_NAME="Domain OS Admin API"

# API version for Swagger docs
# Used by: api
# [OPTIONAL]
API_VERSION="0.0.0"

# Gin framework mode (debug/release)
# Used by: api
# [OPTIONAL]
GIN_MODE="debug"

# Comma-separated allowed origins for CORS
# Used by: api
# [OPTIONAL]
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3002"

# Temporal server address
# Used by: api, worker
# [OPTIONAL]
TEMPORAL_HOST_PORT="temporal:7233"

# Temporal namespace
# Used by: api, worker
# [OPTIONAL]
TEMPORAL_NAMESPACE="default"

# Temporal Cloud API key (replaces mTLS certs)
# Used by: api, worker
# [OPTIONAL] [SECRET] [CLOUD] — not needed for local development
TEMPORAL_API_KEY=""

# Temporal mTLS client key PEM (legacy, use API key instead)
# Used by: api, worker
# [OPTIONAL] [SECRET] [CLOUD] — not needed for local development
TEMPORAL_CLIENT_KEY=""

# Temporal mTLS client cert PEM (legacy, use API key instead)
# Used by: api, worker
# [OPTIONAL] [SECRET] [CLOUD] — not needed for local development
TEMPORAL_CLIENT_CERT=""

# Temporal UI URL for workflow links
# Used by: api
# [OPTIONAL]
TEMPORAL_UI_URL="http://localhost:8081"

# S3-compatible endpoint, hostname only, no scheme. AWS S3:
# s3.<region>.amazonaws.com. Required even when STORAGE_AUTH_MODE=iam —
# the client is minio-go and does not resolve an endpoint from the region.
# Falls back to deprecated MINIO_ENDPOINT
# Used by: api, worker
# [REQUIRED]
STORAGE_ENDPOINT="minio:9000"

# How to obtain S3 credentials: "static" (access key + secret; MinIO, R2,
# S3) or "iam" (short-lived credentials from EKS IRSA, ECS task role, or EC2
# IMDS; AWS S3 only)
# Used by: api, worker
# [OPTIONAL]
STORAGE_AUTH_MODE="static"

# S3 access key ID. Required when STORAGE_AUTH_MODE=static; must be unset
# for iam. Falls back to deprecated MINIO_ACCESS_KEY
# Required when STORAGE_AUTH_MODE=static
# Used by: api, worker
# [OPTIONAL] [SECRET]
STORAGE_ACCESS_KEY="minioadmin"

# S3 secret access key. Required when STORAGE_AUTH_MODE=static; must be
# unset for iam. Falls back to deprecated MINIO_SECRET_KEY
# Required when STORAGE_AUTH_MODE=static
# Used by: api, worker
# [OPTIONAL] [SECRET]
STORAGE_SECRET_KEY="minioadmin"

# Use TLS for S3 connections. Falls back to deprecated MINIO_USE_SSL
# Used by: api, worker
# [OPTIONAL]
STORAGE_USE_SSL="false"

# S3 region for SigV4 signing. Set to the bucket's region for AWS S3, "auto"
# for R2. Empty lets the client resolve it via a bucket-location lookup
# Used by: api, worker
# [OPTIONAL]
STORAGE_REGION=""

# Public S3 endpoint for presigned URLs (if different from
# STORAGE_ENDPOINT). Falls back to deprecated MINIO_PUBLIC_ENDPOINT
# Used by: api
# [OPTIONAL]
STORAGE_PUBLIC_ENDPOINT="http://localhost:9000"

# S3 bucket name for RDE/BRDA escrow deposits (contains PII — kept
# isolated per bucket-storage-strategy)
# Used by: api, worker
# [OPTIONAL]
STORAGE_ESCROW_BUCKET="escrow"

# S3 bucket name for gzip JSONL event archive files (warm-tier event search
# + audit trail)
# Used by: api, worker
# [OPTIONAL]
STORAGE_EVENT_LOGS_BUCKET="event-logs"

# S3 bucket name for Spec 5 compliance sweep CSVs and other generated
# reports. API needs it too for the generic workflow artifact download
# endpoint
# Used by: api, worker
# [OPTIONAL]
STORAGE_REPORTS_BUCKET="reports"

# S3 bucket name for workflow-scoped staging artifacts (snapshots, backups,
# cleanup manifests, verification reports). API needs it too for the generic
# workflow artifact download endpoint
# Used by: api, worker
# [OPTIONAL]
STORAGE_TEMP_BUCKET="temp-artifacts"

# Disable TLS certificate verification for S3 connections. Local development
# against self-signed MinIO only — never enable against R2/S3
# Used by: api, worker
# [OPTIONAL]
STORAGE_TLS_SKIP_VERIFY="false"

# Create missing storage buckets on startup. Local development only —
# production buckets are provisioned out-of-band
# Used by: api, worker
# [OPTIONAL]
STORAGE_AUTO_CREATE_BUCKETS="false"

# Local temp dir for escrow file uploads before S3 transfer
# Used by: api
# [OPTIONAL]
ESCROW_UPLOAD_DIR="/tmp/escrow-uploads"

# Enable New Relic APM
# Used by: api
# [OPTIONAL]
NEW_RELIC_ENABLED="false"

# New Relic license key
# Used by: api
# [OPTIONAL] [SECRET] [CLOUD] — not needed for local development
NEW_RELIC_LICENSE_KEY=""

# Enable Prometheus metrics endpoint
# Used by: api
# [OPTIONAL]
PROMETHEUS_ENABLED="false"

# Log domain lifecycle events
# Used by: api
# [OPTIONAL]
LOG_DOMAIN_EVENTS="true"

# Log level (debug/info/warn/error)
# Used by: epp
# [OPTIONAL]
LOG_LEVEL="debug"

# EPP server TCP listen port
# Used by: epp
# [OPTIONAL]
EPP_PORT="700"

# Redis host for EPP session store
# Used by: epp
# [OPTIONAL]
REDIS_HOST="redis"

# Redis port
# Used by: epp
# [OPTIONAL]
REDIS_PORT="6379"

# Redis password (empty = no auth)
# Used by: epp
# [OPTIONAL] [SECRET] [CLOUD] — not needed for local development
REDIS_PASSWORD=""

# MCP transport mode: 'stdio' for local IDE, 'http' for container deployment
# Used by: mcp
# [OPTIONAL]
MCP_TRANSPORT="stdio"

# HTTP listen port when MCP_TRANSPORT=http
# Used by: mcp
# [OPTIONAL]
MCP_PORT="3001"

# Anthropic API key for AI agent (Agent Alpaca)
# Used by: api, cli
# [OPTIONAL] [SECRET] [CLOUD] — not needed for local development
ANTHROPIC_API_KEY=""

# Anthropic API base URL override
# Used by: api, cli
# [OPTIONAL]
ANTHROPIC_BASE_URL=""

# LLM model name for the AI agent (e.g. claude-sonnet-5)
# Used by: api, cli
# [OPTIONAL]
LLM_MODEL="claude-sonnet-5"

# Root directory for knowledge base docs (docs/index.yaml). Falls back to
# working directory.
# Used by: api, cli
# [OPTIONAL]
KNOWLEDGE_BASE_DIR=""

# Backend API URL (read at container start)
# Used by: frontend
# [REQUIRED]
NEXT_PUBLIC_API_URL="http://localhost:8080"

# Static API token fallback when Auth0 is disabled. Publicly readable in the
# browser — never a real secret
# Used by: frontend
# [OPTIONAL]
NEXT_PUBLIC_API_TOKEN="devtoken"

# Enable Auth0 login flow
# Used by: frontend
# [OPTIONAL]
NEXT_PUBLIC_AUTH0_ENABLED="false"

# Auth0 tenant domain for SPA login
# Used by: frontend
# [OPTIONAL]
NEXT_PUBLIC_AUTH0_DOMAIN=""

# Auth0 SPA application client ID
# Used by: frontend
# [OPTIONAL]
NEXT_PUBLIC_AUTH0_CLIENT_ID=""

# Auth0 API identifier for token audience
# Used by: frontend
# [OPTIONAL]
NEXT_PUBLIC_AUTH0_AUDIENCE=""

# App version displayed in UI. Injected at container start by
# next-runtime-env (not baked into the image); the deployment sets it to the
# release version
# Used by: frontend
# [OPTIONAL]
NEXT_PUBLIC_APP_VERSION="0.0.0"

# Temporal Cloud UI URL for workflow links
# Used by: frontend
# [OPTIONAL]
NEXT_PUBLIC_TEMPORAL_UI_URL="http://localhost:8081"

# Temporal namespace used to build schedule deep-links
# Used by: frontend
# [OPTIONAL]
NEXT_PUBLIC_TEMPORAL_NAMESPACE="default"

# S3 storage browser URL
# Used by: frontend
# [OPTIONAL]
NEXT_PUBLIC_STORAGE_UI_URL="http://localhost:9001"

# PostHog project token. Publicly readable in the browser — never a real
# secret
# Used by: frontend
# [OPTIONAL]
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=""

# PostHog ingestion host
# Used by: frontend
# [OPTIONAL]
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

