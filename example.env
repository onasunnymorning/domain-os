# ============================================================================
# domain-os — Example Environment Configuration
# ============================================================================
#
# Copy this file and configure values for your environment.
# This project uses Doppler for secrets management. Do NOT commit real
# credentials. Use `doppler secrets set KEY=value` to store secrets securely.
#
# For local Docker Compose development, Doppler injects these via .env files.
# For production (Render/K8s), secrets are managed through the platform.
#
# Required vars are marked [REQUIRED], optional are marked [OPTIONAL].
# Secrets (passwords, keys, tokens) are marked [SECRET].
# ============================================================================


# ─── API Server ──────────────────────────────────────────────────────────────
# Core configuration for the Gin-based REST API.

GIN_MODE="debug"                                # [REQUIRED] "debug" | "release" | "test"
API_PORT="8080"                                 # [REQUIRED] Port the API listens on
API_HOST="0.0.0.0"                              # [REQUIRED] Bind address (0.0.0.0 for containers)
API_NAME="domain-os"                            # [REQUIRED] Application name (shown in /ping)
API_VERSION="v1"                                # [REQUIRED] API version string
ADMIN_TOKEN="changeme"                          # [SECRET]   Static admin bearer token for protected endpoints
CORS_ALLOWED_ORIGINS="http://localhost:3000"     # [OPTIONAL] Comma-separated allowed origins


# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
# Two connection modes: individual vars (local) or DATABASE_URL (cloud/Neon).
# If DATABASE_URL is set, it takes precedence over the individual vars.

DATABASE_URL=""                                 # [SECRET]   Full connection string (e.g. postgres://user:pass@host:5432/db?sslmode=require)
DB_HOST="localhost"                             # [REQUIRED] PostgreSQL host (ignored if DATABASE_URL is set)
DB_PORT="5432"                                  # [REQUIRED] PostgreSQL port
DB_NAME="domain-os"                             # [REQUIRED] Database name
DB_USER="postgres"                              # [SECRET]   Database user
DB_PASS="postgres"                              # [SECRET]   Database password
DB_SSLMODE="disable"                            # [OPTIONAL] "disable" | "require" | "verify-full" (use "require" for cloud DBs)
AUTO_MIGRATE="true"                             # [OPTIONAL] Run GORM auto-migration on startup ("true" / "false")


# ─── Temporal (Workflow Engine) ──────────────────────────────────────────────
# Temporal orchestrates all async workflows: domain lifecycle, escrow, sync.
#
# Two task queues partition work:
#   • object-lifecycle  — domain expiry, purge, restore, registrar sync
#   • data-pipeline     — escrow import/staging, TLD cleanup, FX rate updates
#
# Authentication modes (use ONE, not both):
#   • API key    — for Temporal Cloud (set TEMPORAL_API_KEY)
#   • mTLS certs — for self-hosted Temporal (set TEMPORAL_CLIENT_CERT + TEMPORAL_CLIENT_KEY)

TEMPORAL_HOST_PORT="temporal:7233"              # [REQUIRED] Temporal frontend gRPC address
TEMPORAL_NAMESPACE="default"                    # [REQUIRED] Temporal namespace
TEMPORAL_LIFECYCLE_QUEUE="object-lifecycle"     # [REQUIRED] Task queue for lifecycle workflows
TEMPORAL_DATA_QUEUE="data-pipeline"              # [REQUIRED] Task queue for data pipeline workflows
TEMPORAL_API_KEY=""                             # [SECRET]   API key for Temporal Cloud authentication
TEMPORAL_CLIENT_CERT=""                         # [SECRET]   mTLS client certificate (PEM-encoded, for self-hosted Temporal)
TEMPORAL_CLIENT_KEY=""                          # [SECRET]   mTLS client private key (PEM-encoded, for self-hosted Temporal)
TEMPORAL_UI_URL="http://localhost:8081"          # [OPTIONAL] Temporal Web UI base URL (used to build workflow links in API responses)


# ─── Object Storage (MinIO / S3-compatible) ──────────────────────────────────
# Used for escrow file staging, backup storage, and escrow deposits.
# Works with MinIO (local), Backblaze B2, AWS S3, or any S3-compatible provider.

MINIO_ENDPOINT="minio:9000"                    # [REQUIRED] S3-compatible endpoint (host:port)
MINIO_ACCESS_KEY="minioadmin"                   # [SECRET]   Access key ID
MINIO_SECRET_KEY="minioadmin"                   # [SECRET]   Secret access key
MINIO_USE_SSL="false"                           # [OPTIONAL] Enable TLS for S3 connections ("true" for cloud providers like Backblaze B2)
MINIO_PUBLIC_ENDPOINT="localhost:9000"           # [OPTIONAL] Public-facing endpoint for presigned URLs (if behind a proxy)
ESCROW_BUCKET="escrow"                          # [REQUIRED] Bucket name for escrow deposits
ESCROW_UPLOAD_DIR="/tmp/escrow"                 # [OPTIONAL] Temporary local directory for escrow file uploads


# ─── Auth0 (Authentication & Authorization) ──────────────────────────────────
# OAuth2/OIDC via Auth0. Set AUTH0_ENABLED="false" for local development
# without authentication.

AUTH0_ENABLED="false"                           # [REQUIRED] Enable Auth0 middleware ("true" / "false")
AUTH0_DOMAIN=""                                 # [REQUIRED] Auth0 tenant domain (e.g. your-tenant.us.auth0.com)
AUTH0_AUDIENCE=""                               # [REQUIRED] Auth0 API audience identifier
AUTH0_CLIENT_ID=""                              # [SECRET]   Auth0 application client ID (for API)
AUTH0_CLIENT_SECRET=""                          # [SECRET]   Auth0 application client secret (for API)
AUTH0_WORKER_CLIENT_ID=""                       # [SECRET]   Auth0 M2M client ID (for unified worker → API calls)
AUTH0_WORKER_CLIENT_SECRET=""                   # [SECRET]   Auth0 M2M client secret (for unified worker → API calls)


# ─── External APIs ──────────────────────────────────────────────────────────

OPENEXCHANGERATES_APP_ID=""                     # [SECRET]   OpenExchangeRates API key (for FX rate update workflows)


# ─── AI / LLM (askg CLI tool) ───────────────────────────────────────────────
# Powers the `askg` CLI for natural-language domain queries.

ANTHROPIC_API_KEY=""                            # [SECRET]   Anthropic API key
ANTHROPIC_BASE_URL=""                           # [OPTIONAL] Custom Anthropic API base URL (for proxies)


# ─── Observability ──────────────────────────────────────────────────────────

NEW_RELIC_ENABLED="false"                       # [OPTIONAL] Enable New Relic APM ("true" / "false")
NEW_RELIC_LICENSE_KEY=""                         # [SECRET]   New Relic ingest license key
PROMETHEUS_ENABLED="false"                      # [OPTIONAL] Enable /metrics Prometheus endpoint ("true" / "false")
LOG_LEVEL="info"                                # [OPTIONAL] Log level: "debug" | "info" | "warn" | "error"
LOG_DOMAIN_EVENTS="false"                       # [OPTIONAL] Log domain events to stdout ("true" / "false")


# ─── Redis (Caching) ────────────────────────────────────────────────────────
# Optional caching layer. Leave REDIS_HOST empty to disable.

REDIS_HOST="redis"                              # [OPTIONAL] Redis host
REDIS_PORT="6379"                               # [OPTIONAL] Redis port
REDIS_PASSWORD=""                               # [SECRET]   Redis password (empty for local dev)


# ─── Frontend (Next.js) ─────────────────────────────────────────────────────
# NEXT_PUBLIC_* vars are baked into the client JS bundle at build time.
# Set these in the frontend service environment, NOT the API service.

NEXT_PUBLIC_API_URL="http://localhost:8080"                  # [REQUIRED] Backend API URL
NEXT_PUBLIC_AUTH0_ENABLED="false"                            # [REQUIRED] Mirror of AUTH0_ENABLED for the UI
NEXT_PUBLIC_AUTH0_DOMAIN=""                                  # [OPTIONAL] Auth0 domain for frontend login flow
NEXT_PUBLIC_AUTH0_CLIENT_ID=""                               # [OPTIONAL] Auth0 client ID for frontend SPA
NEXT_PUBLIC_AUTH0_AUDIENCE=""                                # [OPTIONAL] Auth0 API audience for frontend tokens
NEXT_PUBLIC_API_TOKEN=""                                     # [SECRET]   Static API token (used when Auth0 is disabled)
NEXT_PUBLIC_APP_VERSION="0.1.0"                              # [OPTIONAL] Version shown in the UI footer
NEXT_PUBLIC_TEMPORAL_UI_URL=""                               # [OPTIONAL] Link to Temporal UI for workflow inspection
NEXT_PUBLIC_GRAFANA_URL=""                                   # [OPTIONAL] Link to Grafana dashboards
