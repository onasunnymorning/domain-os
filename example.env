API_HOST="localhost"
API_PORT="8080"
API_VERSION="0.5.1"
API_NAME="DOS ADMIN API"
AUTO_MIGRATE="true"
# DATABASE_URL takes precedence over individual DB_* vars below.
# Use this for managed databases (e.g. Neon): postgres://user:pass@host/db?sslmode=require
DATABASE_URL=""
DB_HOST="domain-os-db-1"
DB_NAME="domainos"
DB_PASS="myst0ngDBpassw0rd"
DB_PORT="5432"
DB_SSLMODE="require"
DB_USER="postgres"
# CORS — comma-separated list of allowed origins (defaults to http://localhost:3000)
CORS_ALLOWED_ORIGINS="http://localhost:3000"
# API auth token for bearer authentication
ADMIN_TOKEN="devtoken"
EVENT_STREAM_ENABLED="false"
EVENT_STREAM_TOPIC="dos-event-stream"
GIN_MODE="debug"
NEWRELIC_LICENCE_KEY="mylicencekey"
NEWRELIC_USER_KEY="myuserkey"
NEW_RELIC_ENABLED="false"
OPENAI_API_KEY="sk-your-openai-api-key-here"
OPENEXCHANGERATES_APP_ID="myappid"
POSTMAN_API_KEY="myapikey"
POSTMAN_COLLECTION_ID="29101830-241a6a90-ee31-4660-aa4e-1ac1d5a4d035"
POSTMAN_ENVIRONMENT_ID="29101830-558eaa36-036a-4638-91d8-e0544c0977f4"
PROMETHEUS_ENABLED="true"
RMQ_HOST="dos-msg-broker-1"
RMQ_PASS="myst0ngRMQpassw0rd"
RMQ_PORT="5552"
RMQ_USER="guest"
REDIS_HOST="domain-os-redis-1"
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_DB="0"

# Auth0 Configuration
AUTH0_ENABLED="false"
AUTH0_DOMAIN="your-auth0-domain.us.auth0.com"
AUTH0_AUDIENCE="your-auth0-api-audience"
AUTH0_CLIENT_ID="your-auth0-client-id" # For Frontend/API if needed
AUTH0_CLIENT_SECRET="your-auth0-client-secret" # For API if needed

# Worker Auth0 Configuration (M2M)
AUTH0_WORKER_CLIENT_ID="your-auth0-worker-client-id"
AUTH0_WORKER_CLIENT_SECRET="your-auth0-worker-client-secret"

# Frontend Configuration (Next.js public env vars)
NEXT_PUBLIC_API_URL="http://localhost:8080"
NEXT_PUBLIC_AUTH0_ENABLED="false"
NEXT_PUBLIC_AUTH0_DOMAIN="your-auth0-domain.us.auth0.com"
NEXT_PUBLIC_AUTH0_CLIENT_ID="your-auth0-client-id"
NEXT_PUBLIC_AUTH0_AUDIENCE="your-auth0-api-audience"
