    {
      "type": "stat",
      "description": "Age of the stalest node's policy load: one node that stopped reloading still applies obsolete publication and access policies.",
      "title": "Policies last reloaded (stalest node)",
      "id": 17,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 37
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "time() - min(rdap_policies_refreshed_timestamp_seconds{instance=~\"$instance\"})",
          "legendFormat": "ago"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Policy reload and lookup errors",
      "id": 18,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 6,
        "y": 37
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
