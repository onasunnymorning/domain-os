      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(increase(rdap_policy_refresh_errors_total{instance=~\"$instance\"}[5m]))",
