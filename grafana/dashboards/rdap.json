    {
      "type": "stat",
      "title": "Certificate expires in",
      "id": 19,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 5,
        "x": 15,
        "y": 37
