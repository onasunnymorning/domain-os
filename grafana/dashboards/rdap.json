          },
          "refId": "A",
          "expr": "sum by (field) (rate(rdap_redactions_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{field}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Ambiguous nameserver lookups",
      "id": 15,
      "datasource": {
        "type": "prometheus",
